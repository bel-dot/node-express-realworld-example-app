{
  "root": true,
  "ignorePatterns": ["!**/*"],
  "plugins": ["@nx", "sonarjs"],
  "rules": {
    "sonarjs/cognitive-complexity": ["error", 15],
    "complexity": ["warn", 10]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx"],
      "env": {
        "jest": true
      },
      "rules": {}
    }
  ]
}
